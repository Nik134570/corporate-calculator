generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  WORKER
}

enum CalculationStatus {
  DRAFT        // сохранён, цены не менялись
  PENDING      // сохранён с изменёнными ценами, не отправлен
  IN_REVIEW    // отправлен на модерацию
  APPROVED     // одобрен
  REJECTED     // отклонён
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role     @default(WORKER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens    RefreshToken[]
  calculations     Calculation[]
  reviewRequests   ReviewRequest[] @relation("ReviewRequestedBy")
  reviewedRequests ReviewRequest[] @relation("ReviewReviewedBy")
  notifications    Notification[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Справочник материалов (Стекло, Зеркало, Триплекс...)
model Material {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  productTemplates ProductTemplate[]

  @@map("materials")
}

// Наименования изделий (Стекло 4мм, Зеркало 6мм...)
model ProductTemplate {
  id            String   @id @default(uuid())
  materialId    String   @map("material_id")
  thickness     String   // "4мм", "6мм" и т.д.
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  allowTempered Boolean  @default(false) @map("allow_tempered")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  material           Material @relation(fields: [materialId], references: [id])
  products           CalculationProduct[]
  allowedProcessings ProductTemplateProcessing[]
  allowedPieceWorks  ProductTemplatePieceWork[]

  @@map("product_templates")
}

model ProductTemplateProcessing {
  productTemplateId String @map("product_template_id")
  processingId      String @map("processing_id")

  productTemplate ProductTemplate    @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  processing      ProcessingTemplate @relation(fields: [processingId], references: [id], onDelete: Cascade)

  @@id([productTemplateId, processingId])
  @@map("product_template_processings")
}

model ProductTemplatePieceWork {
  productTemplateId String @map("product_template_id")
  pieceWorkId       String @map("piece_work_id")

  productTemplate ProductTemplate   @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  pieceWork       PieceWorkTemplate @relation(fields: [pieceWorkId], references: [id], onDelete: Cascade)

  @@id([productTemplateId, pieceWorkId])
  @@map("product_template_piece_works")
}

model ServiceTemplate {
  id           String   @id @default(uuid())
  name         String
  defaultPrice Decimal  @map("default_price") @db.Decimal(12, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("service_templates")
}

model ProcessingTemplate {
  id            String   @id @default(uuid())
  name          String
  pricePerMeter Decimal  @map("price_per_meter") @db.Decimal(12, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  allowedProductTemplates ProductTemplateProcessing[]

  @@map("processing_templates")
}

model PieceWorkTemplate {
  id        String   @id @default(uuid())
  name      String
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  allowedProductTemplates ProductTemplatePieceWork[]

  @@map("piece_work_templates")
}

model AppSettings {
  id            String   @id @default(uuid())
  temperedPrice Decimal  @map("tempered_price") @db.Decimal(12, 2) @default(100)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Calculation {
  id            String            @id @default(uuid())
  orderNumber   Int               @default(autoincrement()) @map("order_number")
  title         String
  clientName    String            @map("client_name")
  clientPhone   String?           @map("client_phone")
  clientAddress String?           @map("client_address")
  comment       String?
  status        CalculationStatus @default(DRAFT)
  isDraft       Boolean           @default(false) @map("is_draft")
  hasPriceChanges Boolean         @default(false) @map("has_price_changes")

  delivery     Decimal @default(0) @db.Decimal(12, 2)
  lifting      Decimal @default(0) @db.Decimal(12, 2)
  consumables  Decimal @default(0) @db.Decimal(12, 2)
  measurement  Decimal @default(0) @db.Decimal(12, 2)
  installation Decimal @default(0) @db.Decimal(12, 2)

  discountType    String  @default("none") @map("discount_type")
  discountValue   Decimal @default(0) @map("discount_value") @db.Decimal(12, 2)
  complexityType  String  @default("none") @map("complexity_type")
  complexityValue Decimal @default(0) @map("complexity_value") @db.Decimal(12, 2)

  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2)
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy     User                 @relation(fields: [createdById], references: [id])
  products      CalculationProduct[]
  reviewRequest ReviewRequest?

  @@map("calculations")
}

model ReviewRequest {
  id            String   @id @default(uuid())
  calculationId String   @unique @map("calculation_id")
  requestedById String   @map("requested_by")
  reviewedById  String?  @map("reviewed_by")
  comment       String?
  adminComment  String?  @map("admin_comment")
  status        ReviewStatus @default(PENDING)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  calculation Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("ReviewRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?       @relation("ReviewReviewedBy", fields: [reviewedById], references: [id])

  @@map("review_requests")
}

model CalculationProduct {
  id                String  @id @default(uuid())
  calculationId     String  @map("calculation_id")
  productTemplateId String? @map("product_template_id")

  name                String
  width               Decimal @db.Decimal(10, 1)
  height              Decimal @db.Decimal(10, 1)
  quantity            Int     @default(1)
  isTempered          Boolean @default(false) @map("is_tempered")
  pricePerSqm         Decimal @map("price_per_sqm") @db.Decimal(12, 2)
  originalPricePerSqm Decimal? @map("original_price_per_sqm") @db.Decimal(12, 2)
  area                Decimal @db.Decimal(10, 4)
  totalPrice          Decimal @map("total_price") @db.Decimal(12, 2)
  sortOrder           Int     @default(0) @map("sort_order")

  calculation     Calculation         @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  productTemplate ProductTemplate?    @relation(fields: [productTemplateId], references: [id])
  processings     ProductProcessing[]
  pieceWorks      ProductPieceWork[]

  @@map("calculation_products")
}

model ProductProcessing {
  id        String @id @default(uuid())
  productId String @map("product_id")

  name                  String
  pricePerMeter         Decimal  @map("price_per_meter") @db.Decimal(12, 2)
  originalPricePerMeter Decimal? @map("original_price_per_meter") @db.Decimal(12, 2)
  totalPrice            Decimal  @map("total_price") @db.Decimal(12, 2)

  product CalculationProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_processings")
}

model ProductPieceWork {
  id        String @id @default(uuid())
  productId String @map("product_id")

  name              String
  quantity          Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  originalUnitPrice Decimal? @map("original_unit_price") @db.Decimal(12, 2)
  totalPrice        Decimal  @map("total_price") @db.Decimal(12, 2)

  product CalculationProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_piece_works")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  userFullName String   @map("user_full_name")
  action       String
  entityId     String   @map("entity_id")
  entityTitle  String   @map("entity_title")
  details      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
